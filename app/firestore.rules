rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isMentor() {
      return request.auth != null && me().role == 'mentor';
    }
    // CERTIFIED coach: role granted at signup, verification granted by a HUMAN
    // (org/admin flips verifiedMentor). Uncertified coaches see nothing.
    function isCertMentor() {
      return isMentor() && me().verifiedMentor == true;
    }
    function isGuardianOf(pid) {
      return request.auth != null
        && me().role == 'guardian'
        && pid in me().get('guardianOf', []);
    }

    // Profiles: anyone signed-in can read (needed for guardian linking &
    // coach names); only you can write yours.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
    }

    // Sessions: players create/modify their own; readable by owner,
    // mentors (review queue), and the player's linked guardian.
    match /sessions/{id} {
      allow create: if request.auth != null
        && request.resource.data.playerId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.playerId == request.auth.uid
        || isCertMentor()
        || isGuardianOf(resource.data.playerId)
      );
      allow update, delete: if request.auth != null
        && resource.data.playerId == request.auth.uid;
    }

    // Coach comments: ONLY mentors write, as themselves; readable by any
    // signed-in participant (player/guardian views filter by session).
    // No DMs exist anywhere by design — comments attach to sessions only.
    match /comments/{id} {
      allow create: if isCertMentor()
        && request.resource.data.mentorId == request.auth.uid;
      allow read: if request.auth != null;
    }

    // Drill assignments: mentors create; player (or their guardian) reads;
    // player can update status (mark done).
    match /assignments/{id} {
      allow create: if isCertMentor()
        && request.resource.data.assignedBy == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.playerId == request.auth.uid
        || isMentor()
        || isGuardianOf(resource.data.playerId)
      );
      allow update: if request.auth != null
        && resource.data.playerId == request.auth.uid;
    }

    // Blocks: player/guardian block a coach, or a coach hides a player.
    // Creator must be a participant; both sides can read their own blocks.
    match /blocks/{id} {
      allow create: if request.auth != null
        && request.resource.data.byId == request.auth.uid
        && (
          request.resource.data.playerId == request.auth.uid
          || request.resource.data.coachId == request.auth.uid
          || isGuardianOf(request.resource.data.playerId)
        );
      allow read: if request.auth != null && (
        resource.data.playerId == request.auth.uid
        || resource.data.coachId == request.auth.uid
        || isGuardianOf(resource.data.playerId)
      );
      allow delete: if request.auth != null && resource.data.byId == request.auth.uid;
    }

    // Reports: anyone signed-in can file one about a participant; NOBODY can
    // read them in-app — review happens in the admin console only.
    match /reports/{id} {
      allow create: if request.auth != null
        && request.resource.data.byId == request.auth.uid;
      allow read: if false;
    }
  }
}
